# Go backend base URL (see backend/).
# API_URL: server-only, read by src/lib/api-client.ts inside Server
#   Components/Route Handlers.
# NEXT_PUBLIC_API_URL: same value, but exposed to the browser — needed
#   because buy CTAs (src/lib/provider-slug.ts) render as plain <a href>
#   links to the Go backend's /go/... redirect from Client Components.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Shared with backend/.env's CATALOG_SYNC_SECRET — the /admin dashboard and
# "sync now" button proxy through Next.js's server to the Go backend's
# secret-protected /api/internal/{status,catalog/sync} endpoints.
CATALOG_SYNC_SECRET=

# Admin (/admin) — single user, NextAuth Credentials provider.
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# Generate NEXTAUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: bcrypt hashes contain literal `$` characters, and Next.js's env
# loader expands bare `$VAR` references — an unescaped hash gets silently
# truncated (garbage in, login always fails, no error). Escape every `$` as
# `\$` in this file, e.g. `\$2b\$10\$...`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Analytics (only loaded after cookie consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
